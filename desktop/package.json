{
  "name": "crumpet-desktop",
  "productName": "Crumpet",
  "version": "1.0.0",
  "description": "Crumpet: notes and writing, as an app for Mac and Windows.",
  "private": true,
  "main": "main.cjs",
  "author": "Peter Sinclair-Fleeton",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder -c electron-builder.config.cjs --mac dir --universal --publish never",
    "pack:win": "electron-builder -c electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.crumpet.notes",
    "productName": "Crumpet",
    "copyright": "Peter Sinclair-Fleeton",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "google.cjs",
      "google-scheme.cjs",
      "updates.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "web"
      }
    ],
    "protocols": [
      {
        "name": "Crumpet clip",
        "schemes": [
          "crumpet"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Crumpet uses the microphone for dictation.",
        "NSHumanReadableCopyright": "Crumpet"
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Crumpet-Windows.exe",
      "legalTrademarks": "Crumpet"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Crumpet",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Crumpet-Windows.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petersinclairfleeton/crumpet-app.git"
  }
}
