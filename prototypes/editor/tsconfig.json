{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": { "@crumpet/editor/*": ["../../packages/editor/src/*"] }
  },
  "include": ["src", "tests", "../../packages/editor/src"]
}
